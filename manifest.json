{
  "manifest_version": 3,
  "name": "DeepShield",
  "version": "1.1",
  "description": "AI-based Deepfake Detection Alert System",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
  "default_popup": "popup.html"
},

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
